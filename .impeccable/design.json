      "css": ".ds-source{display:inline-flex;align-items:center;gap:.5rem;background:var(--ct-surface,#FFFFFF);border:1px solid var(--ct-line,#E2E8F0);border-radius:var(--ct-control-radius,8px);padding:.65rem .85rem;font-family:var(--ct-font,sans-serif);font-size:.78rem;font-weight:550;color:var(--ct-ink,#172033)}.ds-source svg{width:16px;height:16px;color:var(--ct-primary,#4F46E5)}@media(max-width:640px){.ds-source{padding:.5rem .65rem;font-size:.75rem}}"
