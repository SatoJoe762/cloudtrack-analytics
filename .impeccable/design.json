  "components": [
    {
      "name": "Restablecer filtros",
      "kind": "button",
      "refersTo": "button-reset",
      "description": "Muestra del botón lateral nativo; el runtime y el reset pertenecen a Streamlit.",
      "html": "<button class=\"ds-reset\">Restablecer filtros</button>",
      "css": ".ds-reset{min-height:44px;width:100%;background:var(--ct-sidebar-surface,#202C49);color:var(--ct-sidebar-ink,#F1F5FF);border:1px solid var(--ct-sidebar-border,#40506D);border-radius:var(--ct-control-radius,8px);font-family:var(--ct-font, sans-serif);font-size:.82rem;transition:background-color var(--ct-transition,160ms ease-out),border-color var(--ct-transition,160ms ease-out)}.ds-reset:hover{background:var(--ct-sidebar-hover,#2C3B5B);border-color:var(--ct-sidebar-focus,#A5B4FC)}.ds-reset:focus-visible{outline:2px solid var(--ct-sidebar-focus,#A5B4FC);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-reset{transition:none}}"
    },
    {
      "name": "Descarga",
      "kind": "button",
      "refersTo": "button-download",
      "description": "Acción de exportación; la muestra visual no genera un archivo.",
      "html": "<button class=\"ds-download\">Descargar pedidos filtrados</button>",
      "css": ".ds-download{min-height:44px;background:var(--ct-surface,#FFFFFF);color:var(--ct-primary,#4F46E5);border:1px solid var(--ct-line,#E2E8F0);border-radius:var(--ct-control-radius,8px);font-family:var(--ct-font,sans-serif);transition:background-color var(--ct-transition,160ms ease-out),border-color var(--ct-transition,160ms ease-out)}.ds-download:hover{background:var(--ct-soft,#EEF2FF);border-color:var(--ct-primary,#4F46E5)}.ds-download:focus-visible{outline:2px solid var(--ct-primary,#4F46E5);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-download{transition:none}}"
    },
    {
      "name": "Rango de fechas",
      "kind": "input",
      "refersTo": "input-date",
      "description": "Muestra visual DD/MM/YYYY; la aplicación usa el calendario nativo de Streamlit, no este input de texto.",
      "html": "<label class=\"ds-date\">Fecha del pedido<input class=\"ds-date-field\" aria-label=\"Fecha del pedido\" value=\"01/01/2026 — 31/03/2026\"></label>",
      "css": ".ds-date{display:block;color:var(--ct-sidebar-ink,#F1F5FF);background:var(--ct-sidebar,#151E38);font-family:var(--ct-font,sans-serif);font-size:.8rem;font-weight:550}.ds-date-field{width:100%;background:var(--ct-sidebar-surface,#202C49);border:1px solid var(--ct-sidebar-border,#40506D);border-radius:var(--ct-control-radius,8px);color:var(--ct-sidebar-ink,#F1F5FF);font-family:var(--ct-font,sans-serif);font-size:.75rem;caret-color:var(--ct-sidebar-focus,#A5B4FC)}.ds-date-field:focus-visible{outline:2px solid var(--ct-sidebar-focus,#A5B4FC);outline-offset:3px}"
    },
    {
      "name": "Pestañas de análisis",
      "kind": "nav",
      "refersTo": "tabs",
      "description": "Estados visuales; teclado, selección y paneles reales pertenecen a Streamlit/BaseWeb.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"Análisis\"><button class=\"ds-tab\" role=\"tab\" aria-selected=\"true\">Ventas</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">Entregas</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">Datos y metodología</button></div>",
      "css": ".ds-tabs{display:flex;gap:var(--ct-space-5,1.5rem);border-bottom:1px solid var(--ct-line,#E2E8F0)}.ds-tab{min-height:46px;background:transparent;border:0;color:var(--ct-muted,#64748B);padding:.25rem .1rem .65rem;font-family:var(--ct-font,sans-serif);font-size:.85rem;transition:color var(--ct-transition,160ms ease-out),background-color var(--ct-transition,160ms ease-out)}.ds-tab[aria-selected=true]{color:var(--ct-primary,#4F46E5);font-weight:650;border-bottom:2px solid var(--ct-primary,#4F46E5)}.ds-tab:hover{color:var(--ct-primary,#4F46E5);background:var(--ct-soft,#EEF2FF)}.ds-tab:focus-visible{outline:2px solid var(--ct-primary,#4F46E5);outline-offset:3px}@media(max-width:640px){.ds-tabs{gap:.85rem}.ds-tab{font-size:.76rem;white-space:nowrap}}@media(prefers-reduced-motion:reduce){.ds-tab{transition:none}}"
    },
