# Ejemplo para Cloudflare R2. Copiar como secrets.toml SOLO localmente.
# En Streamlit Community Cloud, pegar los valores en App settings > Secrets.
# Nunca subir secrets.toml a GitHub. Estos nombres AWS los utiliza boto3;
# los valores son credenciales de Cloudflare, no de una cuenta AWS.
CLOUDTRACK_S3_BUCKET = "cloudtrack-datos"
CLOUDTRACK_S3_KEY = "raw/orders.csv"
CLOUDTRACK_S3_ENDPOINT = "https://TU_ACCOUNT_ID.r2.cloudflarestorage.com"
AWS_ACCESS_KEY_ID = "TU_R2_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY = "TU_R2_SECRET_ACCESS_KEY"
