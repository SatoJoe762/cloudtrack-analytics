# Copiar como secrets.toml SOLO si se utiliza S3. Nunca subir secretos.
# Los valores de nivel superior estarán disponibles como variables de entorno.
CLOUDTRACK_S3_BUCKET = "reemplazar-bucket"
CLOUDTRACK_S3_KEY = "raw/orders.csv"
AWS_DEFAULT_REGION = "us-east-1"
# En AWS, preferir un rol IAM y omitir las siguientes claves.
# Fuera de AWS, usar credenciales de solo lectura administradas como secretos.
AWS_ACCESS_KEY_ID = "reemplazar"
AWS_SECRET_ACCESS_KEY = "reemplazar"
# AWS_SESSION_TOKEN = "solo-si-son-credenciales-temporales"
